# Normalise line endings: LF in the repository, native in the working tree.
* text=auto

# Web sources are always LF, even on Windows checkouts.
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Binaries: never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.mp4   binary
*.ico   binary
*.pdf   binary
